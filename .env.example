# ATI Trading Intelligence - Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# =============================================================================
# TRADING MODE
# =============================================================================
# Set to 'false' for paper/simulation mode, 'true' for live (safety gate: both must be true for live)
PAPER_MODE=true
# MUST be 'true' to enable live trading (safety gate)
LIVE_TRADING_AUTHORIZED=false

# =============================================================================
# BROKER CREDENTIALS (Required for Live Mode)
# =============================================================================
# FXCM - Get from https://www.fxcm.com/uk/ → MyFXCM → API Token
FXCM_API_TOKEN=
FXCM_ACCOUNT_ID=

# Deriv - Get from https://deriv.com → Settings → API Token
# Nigeria explicitly supported ✅
DERIV_API_TOKEN=
DERIV_APP_ID=1089

# OANDA (Optional) - Get from https://www.oanda.com → Manage Funds → API
OANDA_API_TOKEN=
OANDA_ACCOUNT_ID=

# =============================================================================
# PROP FIRM SETTINGS
# =============================================================================
# Options: fundingpips | fortradrs
PROP_FIRM=fundingpips

# FundingPips models: flex | classic | rapid
# ForTraders models: classic | strike | fast
PROP_MODEL=flex

# Account type: evaluation | master
PROP_ACCOUNT_TYPE=evaluation

# Starting equity for prop calculations
STARTING_EQUITY=50000.0

# =============================================================================
# MT5 SETTINGS
# =============================================================================
# MT5 Magic Number (must match EA settings)
MT5_MAGIC_NUMBER=123456

# MT5 Data Folder (auto-detected if empty)
# Windows: C:\Users\USER\AppData\Roaming\MetaQuotes\Terminal\<hash>
MT5_DATA_FOLDER=

# =============================================================================
# DATABASE
# =============================================================================
# SQLite (default) or PostgreSQL for production
DB_PATH=data/trading_intelligence.db
# For PostgreSQL: postgresql://user:pass@localhost:5432/ati

# =============================================================================
# API SECURITY
# =============================================================================
# Set to enable API key authentication on REST endpoints
API_KEY=

# =============================================================================
# RISK SETTINGS (Override defaults)
# =============================================================================
RISK_PER_TRADE_PCT=0.02
RISK_PER_SYMBOL_PCT=0.01
RISK_PORTFOLIO_PCT=0.03
RISK_DAILY_LOSS_PCT=0.06
RISK_MONTHLY_LOSS_PCT=0.10
RISK_MAX_DRAWDOWN_PCT=0.20

RISK_VETO_TOXICITY=true
RISK_VETO_IMPACT=true
RISK_KELLY_FROM_MEMORY=false

# =============================================================================
# EXECUTION SETTINGS
# =============================================================================
MAX_SLIPPAGE_PIPS=5.0
MAX_ORDER_AGE_SEC=30.0
PROP_RULES_ENABLED=true

# =============================================================================
# CRYPTO SETTINGS
# =============================================================================
CCXT_ENABLED=true
CCXT_SANDBOX=true
CRYPTO_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT,BNBUSDT,XRPUSDT
CRYPTO_CHANNELS=trade,ticker,book,candle

# =============================================================================
# FOREX SETTINGS
# =============================================================================
FOREX_SYMBOLS=frxEURUSD,frxGBPUSD,frxUSDJPY,frxAUDUSD,frxUSDCAD,frxNZDUSD,frxEURGBP,frxEURJPY,frxGBPJPY
DERIV_SYMBOLS=frxEURUSD,frxGBPUSD,frxUSDJPY,frxAUDUSD,frxUSDCAD,frxNZDUSD,frxEURGBP,frxEURJPY,frxGBPJPY,R_10,R_25,R_50,R_75,R_100,cryBTCUSD,cryETHUSD
DERIV_CHANNELS=ticks,candles

# =============================================================================
# MACRO/NEWS SETTINGS
# =============================================================================
# High-impact news times (ISO format) for prop firm news restrictions
# Example: 2026-08-20T13:30:00+00:00 (CPI), 2026-08-20T18:00:00+00:00 (FOMC)
HIGH_IMPACT_NEWS_TIMES=

# =============================================================================
# API SETTINGS
# =============================================================================
API_ENV=development
API_HOST=127.0.0.1
API_PORT=8000

# =============================================================================
# OMEGA GOD-MODE MULTI-PROVIDER FALLBACK (Zen -> Groq -> OpenRouter)
# =============================================================================
# When true the decision pipeline uses SmartFallbackReasoner (instant key
# rotation, hedged parallel race, circuit-breaker). When false it stays on
# the deterministic RuleBasedSolver (tests/backtests). Keys are loaded from
# env GROQ_API_KEY etc. and/or the Sagax legacy file SAGAX_KEYS_PATH
# (default ~/.config/ati/keys.env, override via SAGAX_KEYS_PATH).
# NEVER commit api_keys.env; use .env or env vars.
OMEGA_ENABLED=false
OMEGA_RACE_MODE=sequential
# Keyless free providers are ALWAYS in the fallback tail: llm7 (DeepSeek-V4-Flash),
# kilo (tencent/hy3:free), ovh (Qwen3-Coder-30B) - no keys needed, zero cost.
# Keyed providers above them win when healthy:
# comma-separated pools: GROQ_API_KEY=gsk_...,gsk_...  OPENROUTER_API_KEY=sk-or-v1-...,sk-or-v1-...
# SAGAX_KEYS_PATH=~/.config/ati/keys.env
# GROQ_API_KEY=
# OPENROUTER_API_KEY=
# CEREBRAS_API_KEY=
# GEMINI_API_KEY=

# =============================================================================
# LOGGING
# =============================================================================
LOG_LEVEL=INFO